# =========================================================
# AWS Route53 Clone - Root Environment Configuration Example
# =========================================================

# --- Frontend Configuration (Next.js) ---
# The public API URL accessible by the browser
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api

# --- Backend Configuration (FastAPI) ---
# Database URL (SQLite for local dev, PostgreSQL for production)
DATABASE_URL=sqlite:///./route53_clone.db

# CORS Allowed Origins (comma-separated list of allowed frontend origins)
CORS_ORIGINS=http://localhost:3000

# Backend Host & Port
HOST=0.0.0.0
PORT=8000
