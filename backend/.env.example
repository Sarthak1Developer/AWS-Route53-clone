# ==============================================
# AWS Route53 Clone - Backend Environment Variables
# ==============================================

# Database Connection URL (SQLite default, or PostgreSQL for production)
DATABASE_URL=sqlite:///./route53_clone.db
# Example for PostgreSQL:
# DATABASE_URL=postgresql://user:password@localhost:5432/route53_clone

# Allowed CORS Origins (comma-separated list of frontend URLs)
CORS_ORIGINS=http://localhost:3000

# Server Host & Port
HOST=0.0.0.0
PORT=8000
